
<style>
  /* ── RESET ──────────────────────────────────────────────── */
  .gg-section * { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── NAVIGATION BAR (DESKTOP) ────────────────────────────── */
  .gg-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 51px;
    position: relative;
    z-index: 100;
  }
  .gg-nav__logo { text-decoration: none; display: block; }
  .gg-nav__logo--sm img { width: 80px;  }
  .gg-nav__logo--md img { width: 120px; }
  .gg-nav__logo--lg img { width: 140px; }
  .gg-nav__logo--xl img { width: 240px; }
  .gg-nav__tagline { 
    font-weight: 400;
    font-size: 16px;
    line-height: 13.42px;
    letter-spacing: 0px;
    text-align: center;
    vertical-align: middle;
   }
  .gg-nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 12px 22px 12px 41px;}
  .gg-nav__cta span{
    
    text-decoration: none;
   font-weight: 400;
font-size: 16px;
line-height: 20.48px;
letter-spacing: 0px;
text-align: center;
vertical-align: middle;
text-transform: uppercase;

  

  }
  .gg-nav__cta svg { width: 24px; height: auto;}

  /* ── HAMBURGER BUTTON (mobile only) ──────────────────────── */
  .gg-nav__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
            position: absolute;
        left: 16px;
        padding: 0;
        width: 18px;
  }
  .gg-nav__hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s ease, opacity 0.2s ease;
    transform-origin: center;
  }
  /* Animate to ✕ when drawer is open */
  .gg-nav__hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .gg-nav__hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .gg-nav__hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── MOBILE DRAWER ───────────────────────────────────────── */
  .gg-nav-drawer {
    display: none; 
    pointer-events: none;
  }
  /* Panel slides in from the right */
  .gg-nav-drawer__panel {
    width: auto;
    display: flex;
    flex-direction: column;
    padding: 0;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
  }
  /* Open state */
  .gg-nav-drawer.is-open {
    pointer-events: all;
  }
  .gg-nav-drawer.is-open .gg-nav-drawer__panel {
    transform: translateX(0);
  }

  /* Drawer body */
  .gg-nav-drawer__body {
    flex: 1;
    padding: 25px;
    display: flex;
    flex-direction: column;
   gap: 16px;
    align-items: center;
  }
  .gg-nav-drawer__tagline {
    font-weight: 400;
    font-size: 16px;
    line-height: 13.42px;
    letter-spacing: 0px;
    text-align: center;
    vertical-align: middle;
  }
  .gg-nav-drawer__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 29px;
    padding: 11.5px 36px 11.5px 50px;
    text-decoration: none;
    transition: opacity 0.2s;
    width: fit-content;
font-weight: 400;
font-size: 16px;
line-height: 20.48px;
letter-spacing: 0px;
text-transform: uppercase;

  }
  .gg-nav-drawer__cta svg {
    width: 28px;
    height: auto;
  }

  /* ── BANNER ──────────────────────────────────────────────── */
  .gg-banner img { display: block; width: 100%; height: auto; }

  /* ── BANNER WITH TEXT ────────────────────────────────────── */
  .gg-banner-text { display: flex; align-items: center; }
  .gg-banner-text--left  { flex-direction: row; }
  .gg-banner-text--right { flex-direction: row-reverse; }
  .gg-banner-text__image {
    max-width: calc(100% - 550px);
    flex: 1 1 calc(100% - 550px);
}
  .gg-hero__content {
    flex: 1 1 550px;
    max-width: 550px;
    min-width: 0;
    padding: 31px 0 35px 68px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }
  .gg-hero__eyebrow { font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: #777; }
  .gg-hero__title   {
    font-weight: 500;
    font-size: 70px;
    line-height: 100%;
    letter-spacing: 0px;
    font-family: var(--font-accent--family);
   }
  .gg-hero__body    { font-weight: 400;
font-size: 20px;
line-height: 140%;
letter-spacing: 0px;
 padding: 50px 0;}
  .gg-hero__btn.hidden-mobile {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
    padding:14px 36px 14px 55px;
        width: fit-content;

  }
  .gg-hero__btn svg { width: 22px; height: 16px;  }

  /* ── MARQUEE ─────────────────────────────────────────────── */
  .gg-marquee {
    padding: 10px 0;
    white-space: nowrap;
    text-align: center;  
  }
  .gg-marquee span{
font-weight: 400;
font-size: 16px;
line-height: 13.42px;
text-align: center;
vertical-align: middle;

  }

  .hidden-desktop{display:none;}
  .hidden-mobile{display:block;}
  /* ── RESPONSIVE ──────────────────────────────────────────── */
  @media(min-width: 1024px){
    
  .gg-nav__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  text-decoration: none;
  background: linear-gradient(to right, var(--color) 50%, var(--bg) 50%);
  background-size: 200% 100%;
  background-position: right bottom;
  color: var(--color);
  transition: background-position 0.4s ease, color 0.4s ease;
}

/* SVG follows text color */
.gg-nav__cta svg path {
  fill: currentColor;
  transition: transform 0.3s ease;
}   .gg-nav__cta:hover {
  background-position: left bottom;
  color: white; /* or any hover color */
}

/* arrow slide */
.gg-nav__cta:hover svg {
  transform: translateX(5px);
}

  }
  @media (max-width: 1199px) {
    .gg-banner-text__image{
            max-width: 50%;
    flex: 1 1 50%;
    }
    .gg-hero__content {
        flex: 1 1 50%;
        max-width: 50%;
    padding: 15px 30px;  }
    .gg-hero__title{font-size:45px;}
    .gg-hero__body{font-size: 16px; padding: 25px 0;}
}
  @media (max-width: 768px) {
    
  .hidden-desktop{display:block;}
  .gg-hero__btn.hidden-mobile{display:none;}
    .gg-nav { padding: 23px 16px; }
    .gg-nav__tagline { display: none; }
    .gg-nav__cta { display: none; }          /* hidden — lives in drawer */
    .gg-nav__hamburger { display: flex; }    
    .gg-nav-drawer.is-open{    display: block;}
       .gg-banner-text__image{
            max-width: 100%;
    flex: 1 1 100%;position: relative; width:100%;
    }
    a.gg-hero__btn.hidden-desktop {
    display: inline-flex;
    position: absolute;
    bottom: 30px;
    left: 0;
    right: 0;
    margin: auto;
            width: fit-content;
        align-items: center;
        gap: 10px;
    padding: 13px 40px 13px 30px;
}

    /* Banner with text stacks */
    .gg-banner-text { flex-direction: column-reverse; }
    .gg-banner-text__image img {
    aspect-ratio: 1 / 0.6;
    object-position: center;
    object-fit: cover;
}
    .gg-hero__content { flex: none; width: 100%;
        padding: 12px 18px;
        flex: 1 1 100%;
        max-width: 100%;text-align: center;gap: 0;
    }
    .gg-banner {    display: none;}
    .gg-hero__body{        padding: 24px 0 0 0;
        line-height: 130%;
    }
    .gg-hero__title {
        font-size: 30px;
        padding-top: 37px;
    }
    .gg-marquee span{
        font-size: 14px;
    }
    .gg-nav{
        justify-content: center;
    }
  }

</style>

<section class="gg-section">

  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- comment -%}━━━━━━━━━━━━━━━━ NAVIGATION BAR ━━━━━━━━━━━━━━━━{%- endcomment -%}
      {%- when 'navigation_bar' -%}
        {%- if block.settings.show_nav -%}

        {%- comment -%} ── Desktop / shared nav bar ── {%- endcomment -%}
        <nav class="gg-nav" {{ block.shopify_attributes }}
             style="background:{{ block.settings.nav_bg }}; color:{{ block.settings.nav_text_color }};">

          <a class="gg-nav__logo gg-nav__logo--{{ block.settings.logo_width }}"
             href="{{ routes.root_url }}">
            {%- if block.settings.brand_logo != blank -%}
              {{- block.settings.brand_logo  -}}
            {%- else -%}
              <span style="font-weight:600;font-size:13px;letter-spacing:0.18em;text-transform:uppercase;color:{{ block.settings.nav_text_color }};">
                {{ shop.name }}
              </span>
            {%- endif -%}
          </a>

          {%- if block.settings.tagline != blank -%}
            <span class="gg-nav__tagline"
                  style="color:{{ block.settings.nav_text_color }};">
              {{ block.settings.tagline }}
            </span>
          {%- endif -%}

          {%- if block.settings.cta_label != blank -%}
            <a class="gg-nav__cta"
               href="{{ block.settings.cta_url }}"
            style="--bg: {{ block.settings.cta_bg }}; --color: {{ block.settings.cta_color }};">
              <span>{{- block.settings.cta_label -}}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="26" height="12" viewBox="0 0 26 12" fill="none">
                <path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
                </svg>
            </a>
          {%- endif -%}

          {%- comment -%} ── Hamburger (mobile only) ── {%- endcomment -%}
          <button
            class="gg-nav__hamburger"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="gg-nav-drawer"
            style="color:{{ block.settings.nav_text_color }};"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>

        </nav>

        {%- comment -%} ── Mobile Drawer ── {%- endcomment -%}
        <div
          class="gg-nav-drawer"
          id="gg-nav-drawer"
          role="dialog"
          aria-modal="true"
          aria-label="Navigation menu"
          hidden
        >

          <div class="gg-nav-drawer__panel"
               style="background:{{ block.settings.nav_bg }}; color:{{ block.settings.nav_text_color }};">

            {%- comment -%} Drawer body {%- endcomment -%}
            <div class="gg-nav-drawer__body">

              {%- if block.settings.tagline != blank -%}
                <p class="gg-nav-drawer__tagline"
                   style="color:{{ block.settings.nav_text_color }};">
                  {{ block.settings.tagline }}
                </p>
              {%- endif -%}

              {%- if block.settings.cta_label != blank -%}
                <a class="gg-nav-drawer__cta"
                   href="{{ block.settings.cta_url }}"
                   style="background:{{ block.settings.cta_bg }};color:{{ block.settings.cta_color }};">
                  {{ block.settings.cta_label }}
                     <svg xmlns="http://www.w3.org/2000/svg" width="26" height="12" viewBox="0 0 26 12" fill="none">
                <path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
                </svg>
                </a>
              {%- endif -%}

            </div>
          </div>
        </div>

        {%- endif -%}

      {%- comment -%}━━━━━━━━━━━━━━━━ BANNER ━━━━━━━━━━━━━━━━━━━━━━━━{%- endcomment -%}
      {%- when 'banner' -%}
        {%- if block.settings.image != blank -%}
        <div class="gg-banner" {{ block.shopify_attributes }}>
          {{- block.settings.image
              | image_url: width: 2400
              | image_tag:
                  alt: block.settings.image.alt | default: shop.name,
                  loading: 'lazy',
                  fetchpriority: 'high' -}}
        </div>
        {%- endif -%}

      {%- comment -%}━━━━━━━━━━━━━━━━ BANNER WITH TEXT ━━━━━━━━━━━━━━{%- endcomment -%}
      {%- when 'banner_with_text' -%}
        <div class="gg-banner-text gg-banner-text--{{ block.settings.image_position }}"
             {{ block.shopify_attributes }}>

          {%- if block.settings.image != blank -%}
            <div class="gg-banner-text__image">
              {{- block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                      alt: block.settings.image.alt | default: block.settings.heading,
                      loading: 'lazy' -}}
            {%- if block.settings.cta_label != blank -%}
              <a class="gg-hero__btn hidden-desktop"
                 href="{{ block.settings.cta_url }}"
                 style="background:{{ block.settings.btn_bg }};color:{{ block.settings.btn_color }};">
                {{ block.settings.cta_label }}
        <svg xmlns="http://www.w3.org/2000/svg" width="27" height="12" viewBox="0 0 27 12" fill="none">
<path d="M0.75 4.77295L7.83954e-08 4.77295L-7.83954e-08 6.27295L0.75 6.27295L0.75 4.77295ZM26.7876 6.05328C27.0805 5.76039 27.0805 5.28551 26.7876 4.99262L22.0146 0.21965C21.7217 -0.0732435 21.2468 -0.0732435 20.9539 0.21965C20.6611 0.512543 20.6611 0.987417 20.9539 1.28031L25.1966 5.52295L20.9539 9.76559C20.6611 10.0585 20.6611 10.5334 20.9539 10.8263C21.2468 11.1191 21.7217 11.1191 22.0146 10.8263L26.7876 6.05328ZM0.75 6.27295L26.2572 6.27295L26.2572 4.77295L0.75 4.77295L0.75 6.27295Z" fill="white"/>
</svg>
              </a>
            {%- endif -%}
            </div>
          {%- endif -%}

          <div class="gg-hero__content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="gg-hero__eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="gg-hero__title">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="gg-hero__body hidden-mobile">{{ block.settings.body }}</p>
            {%- endif -%}
            {%- if block.settings.body_mobile != blank -%}
              <p class="gg-hero__body hidden-desktop">{{ block.settings.body_mobile }}</p>
            {%- endif -%}
            {%- if block.settings.cta_label != blank -%}
              <a class="gg-hero__btn hidden-mobile"
                 href="{{ block.settings.cta_url }}"
                 style="background:{{ block.settings.btn_bg }};color:{{ block.settings.btn_color }};">
                {{ block.settings.cta_label }}
        <svg xmlns="http://www.w3.org/2000/svg" width="27" height="12" viewBox="0 0 27 12" fill="none">
<path d="M0.75 4.77295L7.83954e-08 4.77295L-7.83954e-08 6.27295L0.75 6.27295L0.75 4.77295ZM26.7876 6.05328C27.0805 5.76039 27.0805 5.28551 26.7876 4.99262L22.0146 0.21965C21.7217 -0.0732435 21.2468 -0.0732435 20.9539 0.21965C20.6611 0.512543 20.6611 0.987417 20.9539 1.28031L25.1966 5.52295L20.9539 9.76559C20.6611 10.0585 20.6611 10.5334 20.9539 10.8263C21.2468 11.1191 21.7217 11.1191 22.0146 10.8263L26.7876 6.05328ZM0.75 6.27295L26.2572 6.27295L26.2572 4.77295L0.75 4.77295L0.75 6.27295Z" fill="white"/>
</svg>
              </a>
            {%- endif -%}
          </div>

        </div>

      {%- comment -%}━━━━━━━━━━━━━━━━ MARQUEE BAR ━━━━━━━━━━━━━━━━━━━{%- endcomment -%}
      {%- when 'marquee_bar' -%}
        {%- if block.settings.text != blank -%}
            <div class="gg-marquee"   style="background:{{ block.settings.bg_color }};">
                    <span style="color:{{ block.settings.text_color }};" class="hidden-desktop">{{ block.settings.text }}</span>
                     <span style="color:{{ block.settings.text_color }};" class="hidden-mobile">{{ block.settings.text_desktop }}</span>
            </div>
        {%- endif -%}

    {%- endcase -%}
  {%- endfor -%}

</section>

{% javascript %}
(function () {
  /* ── Grab elements ────────────────────────────────────── */
  const burger  = document.querySelector('.gg-nav__hamburger');
  const drawer  = document.getElementById('gg-nav-drawer');
  const closeBtn = drawer ? drawer.querySelector('.gg-nav-drawer__close') : null;

  if (!burger || !drawer) return;

  /* ── Helpers ──────────────────────────────────────────── */
  function openDrawer() {
    drawer.hidden = false;
    // rAF ensures transition fires after display
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        drawer.classList.add('is-open');
        burger.setAttribute('aria-expanded', 'true');
        burger.setAttribute('aria-label', 'Close menu');
        document.documentElement.style.overflow = 'hidden';
      });
    });
  }

  function closeDrawer() {
    drawer.classList.remove('is-open');
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', 'Open menu');
    document.documentElement.style.overflow = '';
    /* wait for transition to finish, then hide */
    drawer.addEventListener('transitionend', function onEnd() {
      drawer.hidden = true;
      drawer.removeEventListener('transitionend', onEnd);
    }, { once: true });
  }

  /* ── Events ───────────────────────────────────────────── */
  burger.addEventListener('click', function () {
    if (drawer.classList.contains('is-open')) {
      closeDrawer();
    } else {
      openDrawer();
    }
  });

  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
      closeDrawer();
    }
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Gift Guide Hero",
  "tag": "section",
  "class": "gift-guide-hero",
  "settings": [],
  "blocks": [

    {
      "type": "navigation_bar",
      "name": "Navigation Bar",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_nav",
          "label": "Show navigation bar",
          "default": true
        },
        {
          "type": "color",
          "id": "nav_bg",
          "label": "Bar background",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "nav_text_color",
          "label": "Tagline & fallback logo color",
          "default": "#0d0d0d"
        },
        {
          "type": "html",
          "id": "brand_logo",
          "label": "Brand logo SVG"
        },
        {
          "type": "select",
          "id": "logo_width",
          "label": "Logo width",
          "options": [
            { "value": "sm", "label": "Small — 80px"        },
            { "value": "md", "label": "Medium — 120px"      },
            { "value": "lg", "label": "Large — 140px"       },
            { "value": "xl", "label": "Extra large — 240px" }
          ],
          "default": "md"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "Find the ideal gift for your loved ones."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "CHOOSE GIFT"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "cta_bg",
          "label": "Button background",
          "default": "#f5e200"
        },
        {
          "type": "color",
          "id": "cta_color",
          "label": "Button text color",
          "default": "#0d0d0d"
        }
      ]
    },

    {
      "type": "banner",
      "name": "Banner",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Full-width banner image"
        }
      ]
    },

    {
      "type": "banner_with_text",
      "name": "Banner with Text",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Side image"
        },
        {
          "type": "select",
